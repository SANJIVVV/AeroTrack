# AeroTrack Pro environment. Copy to .env and fill in locally. NEVER commit .env.
# Placeholders below are not real values.

NODE_ENV=development
PORT=4000

# MongoDB Atlas. Replace <URL_ENCODED_PASSWORD> locally with your (rotated) password,
# percent-encoded if it contains reserved characters (see README "MongoDB Atlas setup").
MONGODB_URI=mongodb+srv://sanjivvv19_db_user:<URL_ENCODED_PASSWORD>@aerotrack.7fv3sq4.mongodb.net/aerotrack_pro?retryWrites=true&w=majority
MONGODB_DB_NAME=aerotrack_pro
# DB_NAME is accepted as an alias for MONGODB_DB_NAME.
# Check the connection (ping + test write/read/delete, prints only the host): npm run db:check

# Where the browser app runs (used for CORS and links in emails). The Node.js server
# serves the plain HTML/CSS/JS client itself, so this is the same address as the server.
CLIENT_URL=http://localhost:4000
# Extra allowed origins, comma separated (optional).
CORS_ORIGINS=
# Public URL of the API, for documentation/deployment reference (optional).
API_BASE_URL=http://localhost:4000

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
# JWT_SECRET is accepted as an alias for SESSION_SECRET (sessions are server-side, not JWTs).
SESSION_TTL_HOURS=168
# lax for same-site deployments; none only when client and API are on different sites over HTTPS.
COOKIE_SAMESITE=lax
# true when running behind a reverse proxy such as Render.
TRUST_PROXY=false
# true (default) serves the client/ folder from the API server. Set false only if you
# host the client files somewhere else (then set AEROTRACK_API_BASE in client/js/config.js).
SERVE_CLIENT=true

# Email (OTP codes): smtp | dev | none
#   smtp = sent through your own SMTP server with nodemailer (e.g. a Gmail App Password)
#   dev  = codes kept in an in-memory dev outbox and shown on screen. Ignored when NODE_ENV=production.
#   none = no email at all
EMAIL_PROVIDER=dev
EMAIL_FROM=AeroTrack Pro <no-reply@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Client settings live in client/js/config.js (no build step). Set AEROTRACK_PUBLIC_URL there
# so pasted tracking links from your public domain are accepted by "Paste QR Code Content".

# Flights: no external flight API is used. Airlines and sample flights come from a local
# seed (npm run seed) and are always labelled as demonstration data.

# Optional trained delay model (see ml/README). Unset = transparent rules baseline.
DELAY_MODEL_PATH=
ANOMALY_SWEEP_INTERVAL_MIN=5
LOG_LEVEL=info
